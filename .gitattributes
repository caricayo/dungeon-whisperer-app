# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf

# Configuration files
*.config.js text eol=lf
*.config.ts text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf
tsconfig*.json text eol=lf
package.json text eol=lf
package-lock.json text eol=lf

# Documentation
*.txt text eol=lf
*.md text eol=lf
LICENSE text eol=lf
README* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary

# Archive files
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Media files
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.webm binary

# Exclude files from export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
*.test.js export-ignore
*.test.ts export-ignore
*.spec.js export-ignore
*.spec.ts export-ignore

# Linguist overrides for accurate language detection
*.sql linguist-detectable=true
*.md linguist-documentation=true
docs/* linguist-documentation=true